{
  "name": "stock-ranker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prisma-schema.mjs && node scripts/build-prompts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prisma-schema.mjs && node scripts/build-prompts.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "pretest": "node scripts/prisma-schema.mjs && node scripts/build-prompts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:schema": "node scripts/prisma-schema.mjs",
    "prisma:generate": "node scripts/prisma-schema.mjs && prisma generate",
    "db:migrate": "node scripts/prisma-schema.mjs && prisma migrate dev",
    "db:deploy": "node scripts/prisma-schema.mjs && prisma migrate deploy",
    "db:push": "node scripts/prisma-schema.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "vercel-build": "node scripts/prisma-schema.mjs && node scripts/build-prompts.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "partial-json": "^0.1.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
