# ---------- Database ----------
# sqlite locally, postgresql on Vercel (Neon / Supabase). schema.prisma is generated
# from DATABASE_PROVIDER by `npm run prisma:schema`.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Postgres example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
# Cheapest model with good quality for a public app. Env-switchable to claude-opus-5.
ANALYSIS_MODEL=claude-sonnet-5
ANALYSIS_EFFORT=low
NEWS_SEARCH_MODEL=claude-sonnet-5
NEWS_WEB_SEARCH_FALLBACK=true

# ---------- Market data ----------
# yahoo (no key, default — powers analysis, financials, charts, ownership) | fmp | finnhub | fixture
DATA_PROVIDER=yahoo
FMP_API_KEY=
FINNHUB_API_KEY=

# ---------- Auth (Auth.js v5) ----------
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET=
# Google OAuth (free) — create at console.cloud.google.com; callback /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only password-less sign-in for testing without Google. Never enable in prod.
AUTH_DEV_LOGIN=false
# Comma-separated admin emails (the costs page, user list, ban, runtime quota controls).
ADMIN_EMAILS=

# ---------- Abuse protection ----------
# Cloudflare Turnstile (free). Optional; skipped when unset.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RATE_LIMIT_PER_MIN=20

# ---------- Public-app cost guardrails ----------
# Free fresh AI analyses per user per day; cached views are unlimited.
FREE_DAILY_FRESH_ANALYSES=3
# Global daily cap on fresh analyses (protects the bill regardless of signups).
MAX_ANALYSES_PER_DAY=200
# Hard dollar kill switch: fresh analyses pause past this; users get cached results + a notice.
DAILY_SPEND_CEILING_USD=15
MAX_CRON_TICKERS=20
RAW_CACHE_MINUTES=15
ANALYSIS_TTL_HOURS=24
SMART_REFRESH=true
SMART_REFRESH_PRICE_MOVE_PCT=3

# ---------- Cron ----------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. Also lets you trigger /api/cron/* by hand.
CRON_SECRET=change-me

# ---------- App ----------
APP_URL=http://localhost:3000
# true = serve only the 5 seeded demo tickers, no keys, no per-visitor cost.
DEMO_MODE=false
