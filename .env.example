# ---------- Database ----------
# sqlite locally, postgresql on Vercel (Neon / Supabase). The provider line in
# prisma/schema.prisma is generated from DATABASE_PROVIDER by `npm run prisma:schema`.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Postgres example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
# Model used for the full analysis (judgment fields only; numbers never come from the model).
ANALYSIS_MODEL=claude-opus-5
# Effort for the analysis call: low | medium | high | xhigh | max
ANALYSIS_EFFORT=medium
# Cheaper model used only for the web-search news fallback.
NEWS_SEARCH_MODEL=claude-sonnet-5
# Use Anthropic web search when the data provider returns no 7-day news (~$0.03 per use).
NEWS_WEB_SEARCH_FALLBACK=true

# ---------- Market data ----------
# yahoo (no key, default) | fmp | finnhub
DATA_PROVIDER=yahoo
FMP_API_KEY=
FINNHUB_API_KEY=

# ---------- Cost guardrails ----------
MAX_ANALYSES_PER_DAY=40
MAX_CRON_TICKERS=20
RAW_CACHE_MINUTES=15
ANALYSIS_TTL_HOURS=24
# Nightly cron only re-analyzes a ticker when something changed (new filing, new news,
# price move above the threshold) or the analysis is older than ANALYSIS_TTL_HOURS.
SMART_REFRESH=true
SMART_REFRESH_PRICE_MOVE_PCT=3

# ---------- Auth ----------
# Key for the external JSON API (send as `x-api-key` header or `?api_key=`).
API_KEY=change-me
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically when this is set.
CRON_SECRET=change-me-too

# ---------- Alerts & digest ----------
# telegram | email | console (console just logs; use locally)
ALERT_CHANNEL=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_FROM="Stock Ranker <onboarding@resend.dev>"
ALERT_EMAIL_TO=
# Watchlist slug the morning digest summarises (defaults to the first watchlist).
DIGEST_WATCHLIST=main

# ---------- App ----------
# Public base URL used in alert links and share links.
APP_URL=http://localhost:3000
# true = only the 5 seeded demo tickers are served, no model calls, no data-provider calls.
DEMO_MODE=false
