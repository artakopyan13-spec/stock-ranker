// Source of truth. `npm run prisma:schema` writes prisma/schema.prisma with the
// datasource provider taken from DATABASE_PROVIDER (sqlite | postgresql).
// Only types supported by BOTH providers are used: String, Int, Float, Boolean, DateTime.
// JSON payloads are stored as String and validated with Zod on read.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "__PROVIDER__"
}

model Ticker {
  symbol     String   @id
  name       String
  exchange   String?
  currency   String   @default("USD")
  sector     String?
  industry   String?
  shareToken String   @unique
  isDemo      Boolean  @default(false)
  searchCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses  Analysis[]
  snapshots RawSnapshot[]
  items     WatchlistItem[]
}

/// Normalized StockData from a provider, cached for RAW_CACHE_MINUTES.
model RawSnapshot {
  id        String   @id @default(cuid())
  symbol    String
  provider  String
  payload   String
  fetchedAt DateTime @default(now())

  ticker Ticker @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@index([symbol, fetchedAt])
}

/// One verified analysis. Kept forever so rating changes can be diffed.
model Analysis {
  id               String   @id @default(cuid())
  symbol           String
  version          Int
  promptVersion    String
  model            String
  source           String   // ondemand | cron | seed
  payload          String   // JSON Analysis
  rating           Int
  action           String   // BUY | HOLD | SELL
  fcfVerdict       String   // healthy | thin | negative
  fcfMarginPct     Float?
  revenueGrowthPct Float?
  forwardPE        Float?
  priceAtAnalysis  Float?
  verified         Boolean  @default(false)
  usdCost          Float    @default(0)
  dataAsOf         DateTime
  createdAt        DateTime @default(now())

  ticker Ticker  @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  changes Change[]

  @@unique([symbol, version])
  @@index([symbol, createdAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  userId    String?  // null = seeded/global (e.g. demo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String @id @default(cuid())
  watchlistId String
  symbol      String
  position    Int    @default(0)

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  ticker    Ticker    @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  @@unique([watchlistId, symbol])
}

/// One nightly refresh. batchId is unique so a re-run never submits twice for the same run.
model RefreshRun {
  id          String    @id @default(cuid())
  runKey      String    @unique // e.g. 2026-09-16 — one run per calendar day
  status      String    // planned | submitted | collected | failed | skipped
  mode        String    // batch | sync
  batchId     String?   @unique
  tickers     String    // JSON string[] of symbols submitted
  skipped     String    // JSON string[] of symbols skipped by smart refresh
  startedAt   DateTime  @default(now())
  collectedAt DateTime?
  error       String?
  usdCost     Float     @default(0)
}

/// The exact StockData each batch request was built from, so the collector assembles
/// against the same numbers the model saw. Deleted after collection.
model CronPayload {
  id               String  @id @default(cuid())
  runKey           String
  symbol           String
  data             String
  previousTripwire String?

  @@unique([runKey, symbol])
}

/// One "what changed" entry, keyed so a re-run never records the same event twice.
model Change {
  id         String   @id @default(cuid())
  key        String   @unique // `${symbol}:${type}:${analysisId}`
  symbol     String
  type       String   // rating_change | verdict_flip | tripwire | fcf_negative
  message    String
  analysisId String
  runKey     String?  // set when produced by a nightly refresh
  createdAt  DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([symbol, createdAt])
}

/// Every model call, for /admin/costs and the daily cap.
model UsageLog {
  id                String   @id @default(cuid())
  symbol            String?
  kind              String   // analysis | news_search | batch_analysis
  model             String
  inputTokens       Int
  cacheReadTokens   Int      @default(0)
  cacheWriteTokens  Int      @default(0)
  outputTokens      Int
  usd               Float
  userId            String?  // who triggered it (null = cron/system)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}


// ---------- Auth.js (email + Google) ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // user | admin
  banned        Boolean   @default(false)
  dailyQuota    Int?      // per-user override of FREE_DAILY_FRESH_ANALYSES
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  watchlists  Watchlist[]
  savedScreens SavedScreen[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A user's saved screener filter set.
model SavedScreen {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   String   // JSON ScreenFilters
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Admin-editable runtime settings (kill switch, quota defaults) — no redeploy needed.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// DB-backed rate limiter: one row per (key, window). Cheap, no Redis.
model RateLimit {
  key         String   @id // e.g. "user:<id>:min:<epochMinute>" or "ip:<ip>:min:<n>"
  count       Int      @default(0)
  windowStart DateTime @default(now())
}
